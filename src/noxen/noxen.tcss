Screen {
    background: $background;
    color: $foreground;
}
/* A button fits its label with one space on each side (Textual adds that space).
   Textual's default minimum width centred short labels with the odd column on the right. */
Button {
    min-width: 0 !important;
    padding: 0 !important;
}
ModalScreen {
    background: $background 16%;
}
ModalScreen:light {
    background: $foreground 16%;
}
MonitorActionsMenu, MonitorActionsMenu:light {
    background: transparent;
}
Toast:light {
    background: #E5E9E7;
    color: $foreground;
}
Screen, RichLog, DataTable, VerticalScroll, ScrollableContainer {
    scrollbar-background: $surface;
    scrollbar-color: $foreground-muted;
    scrollbar-color-hover: $success;
    scrollbar-color-active: $success;
}
#intercept_header {
    height: 3;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
#intercept_header Button {
    width: auto;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}
#intercept_header Button:focus {
    border: none;
    text-style: bold;
    background-tint: $surface 0%;
}
#intercept_header #intercept_toggle,
#intercept_header #btn_forward,
#intercept_header #btn_drop,
#intercept_header #btn_edit,
#intercept_header #btn_cancel_edit {
    height: 3;
    margin: 0 1 0 0;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground-muted;
    text-style: bold;
}
#intercept_header #intercept_toggle:focus,
#intercept_header #btn_forward:focus,
#intercept_header #btn_drop:focus,
#intercept_header #btn_edit:focus,
#intercept_header #btn_cancel_edit:focus,
#intercept_header #intercept_toggle:hover,
#intercept_header #btn_forward:hover,
#intercept_header #btn_drop:hover,
#intercept_header #btn_edit:hover,
#intercept_header #btn_cancel_edit:hover {
    border: round $foreground-muted;
    background: $boost;
    background-tint: $surface 0%;
}
#intercept_header #intercept_toggle.intercept-on,
#intercept_header #intercept_toggle.intercept-on:focus,
#intercept_header #intercept_toggle.intercept-on:hover {
    border: round $success;
    background: $boost;
    color: $success;
}
#intercept_header #intercept_toggle.intercept-off,
#intercept_header #intercept_toggle.intercept-off:focus,
#intercept_header #intercept_toggle.intercept-off:hover {
    border: round $warning;
    background: $boost;
    color: $warning;
}
#intercept_header #btn_forward.forward-ready,
#intercept_header #btn_forward.forward-ready:focus,
#intercept_header #btn_forward.forward-ready:hover {
    border: round $secondary-darken-1;
    background: $boost;
    color: $secondary;
}
#intercept_header #btn_forward.apply-forward {
    width: 21;
    min-width: 21;
}
#intercept_header #btn_drop.drop-ready,
#intercept_header #btn_drop.drop-ready:focus,
#intercept_header #btn_drop.drop-ready:hover {
    border: round $error-darken-1;
    background: $boost;
    color: $error;
}
#intercept_header #btn_edit.edit-ready,
#intercept_header #btn_edit.edit-ready:focus,
#intercept_header #btn_edit.edit-ready:hover {
    border: round $secondary;
    background: $boost;
    color: $secondary-lighten-2;
}
#intercept_header #btn_edit.edit-ready:light {
    color: $secondary;
}
#intercept_header #btn_cancel_edit {
    display: none;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground;
}
#intercept_header #btn_cancel_edit:focus,
#intercept_header #btn_cancel_edit:hover {
    border: round $accent;
    background: $boost;
    color: $accent;
}
#intercept_header #btn_forward:disabled,
#intercept_header #btn_drop:disabled,
#intercept_header #btn_edit:disabled {
    border: round $foreground-muted;
    background: transparent;
    color: $foreground-muted;
}
#intercept_header #btn_intercept_filters,
#intercept_header #btn_intercept_stack {
    height: 3;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground;
}
#intercept_header #btn_intercept_filters:focus,
#intercept_header #btn_intercept_stack:focus,
#intercept_header #btn_intercept_filters:hover,
#intercept_header #btn_intercept_stack:hover {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#session_bar {
    height: 1;
    background: $background;
    padding: 0 1;
    align: right middle;
}
#session_bar.connecting {
    background: $secondary;
}
#session_bar.connected {
    background: $success;
}
#session_bar.hook-warning {
    background: $warning;
}
#session_bar.connection-error {
    background: $error;
}
#session_info {
    color: $foreground-muted;
    height: 1;
}
#session_bar.connecting #session_info,
#session_bar.connected #session_info,
#session_bar.hook-warning #session_info,
#session_bar.connection-error #session_info {
    color: $button-color-foreground;
}
#intercept_header #intercept_toggle {
    width: auto;
}
#intercept_header_spacer { width: 1fr; }
TabbedContent {
    height: 1fr;
}
Tabs .underline--bar {
    color: $success;
}
Tab { text-style: bold; }
Tab:light { color: $foreground-muted; }
Tab:light:hover { color: $foreground; }
Tab:light:disabled { color: $foreground-disabled; }
Tab.-active, Tab.-active:focus { background: transparent; color: $foreground; }
Tab.intercepted, Tab.intercepted:light:hover { color: $error; }
TabbedContent.subtabs > ContentTabs { height: 2; padding-bottom: 1; }
TabbedContent.subtabs > ContentTabs Underline { display: none; }
TabbedContent.subtabs > ContentTabs Tab {
    background: transparent;
    color: $foreground-muted;
    text-style: none;
}
TabbedContent.subtabs > ContentTabs Tab:hover {
    color: $foreground;
}
TabbedContent.subtabs > ContentTabs Tab.-active {
    background: transparent;
    color: $foreground;
    text-style: bold underline;
}
TabPane {
    padding: 0;
    layout: vertical;
    background: $background;
}
#intercept_output {
    background: $surface;
    height: 1fr;
    margin: 1 1;
}
#log_header {
    height: 3;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
#log_output {
    background: $surface;
    height: 1fr;
    margin: 1 1;
}
#history_table, #history_detail {
    height: 1fr;
    margin: 1 1;
}
#history_detail {
    background: $surface;
}
.section_separator {
    color: $foreground 10%;
}
.section_separator.-horizontal { margin: 0 1; }
#history_header {
    height: 3;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
#history_header Button {
    width: auto;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}
#history_header Button:focus {
    border: none;
    text-style: bold;
    background-tint: $surface 0%;
}
#filter_bar_spacer { width: 0; }
#history_search {
    width: 1fr;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    background: transparent;
    border: round $foreground-muted;
}
#history_header #btn_history_filters,
#history_header #btn_history_sender,
#history_header #btn_history_stack {
    height: 3;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground;
}
#history_header #btn_history_filters:focus,
#history_header #btn_history_stack:focus,
#history_header #btn_history_sender:focus,
#history_header #btn_history_sender:hover,
#history_header #btn_history_filters:hover,
#history_header #btn_history_stack:hover {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#history_header #btn_columns,
#monitor_pane #monitor_columns {
    margin: 0;
    padding: 0 1;
    width: auto;
    min-width: 0;
    height: 3;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#monitor_pane #monitor_columns { margin-left: 1; }
#history_header #btn_columns:hover,
#history_header #btn_columns:focus,
#monitor_pane #monitor_columns:hover,
#monitor_pane #monitor_columns:focus {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#intercept_cmd_output {
    height: 7;
    margin: 0 1;
    background: $background;
}
#intercept_input_wrapper {
    height: 4;
    padding: 0 1 0 1;
}
#intercept_input_bar {
    height: 3;
    border: round $warning;
    padding: 0 1;
    align: left middle;
    background: $background;
}
#intercept_command_input, #history_command_input { background: transparent; }
#intercept_prompt_char {
    width: auto;
    height: 100%;
    content-align: left middle;
    margin-right: 1;
    color: $warning;
}
Input {
    border: none;
    width: 1fr;
}
Input:focus {
    border: none;
    background-tint: $surface 0%;
}
Input:light > .input--placeholder,
Input:light > .input--suggestion {
    color: $foreground-muted;
}
#monitor_search,
#mcp_port,
#monitor_dialog Input {
    height: 3;
    padding: 0 1;
    border: round $foreground-muted;
}
#monitor_search { background: transparent; }
#monitor_search:focus,
#mcp_port:focus,
#monitor_dialog Input:focus { border: round $accent; }
MCPPane Button,
SenderPane Button,
#log_crashes,
#info_prepare_sender,
#crash_actions Button,
#monitor_pane .monitor_controls Button,
#monitor_dialog Button,
#monitor_restore_dialog Button,
#recording_dialog Button {
    height: 3;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground;
    text-style: bold;
    tint: transparent;
    background-tint: transparent;
}
MCPPane Button:hover,
SenderPane Button:hover,
SenderPane Button:focus,
SenderPane Button.-active,
MCPPane Button:focus,
MCPPane Button.-active,
#log_crashes:hover,
#info_prepare_sender:hover,
#info_prepare_sender:focus,
#info_prepare_sender.-active,
#log_crashes:focus,
#log_crashes.-active,
#crash_actions Button:hover,
#crash_actions Button:focus,
#crash_actions Button.-active,
#monitor_pane .monitor_controls Button:hover,
#monitor_pane .monitor_controls Button:focus,
#monitor_pane .monitor_controls Button.-active,
#monitor_dialog Button:hover,
#monitor_dialog Button:focus,
#monitor_dialog Button.-active,
#monitor_restore_dialog Button:hover,
#monitor_restore_dialog Button:focus,
#monitor_restore_dialog Button.-active,
#recording_dialog Button:hover,
#recording_dialog Button:focus,
#recording_dialog Button.-active {
    border: round $accent;
    color: $accent;
}
MCPPane Button:disabled,
SenderPane Button:disabled,
#monitor_pane .monitor_controls Button:disabled,
#monitor_dialog Button:disabled {
    border: round $foreground-muted;
    color: $foreground-muted;
}
#intercept_input_bar.intercepted {
    border: round $error;
}
#intercept_input_bar.intercepted #intercept_prompt_char {
    color: $error;
}
#intercept_cmd_suggestions {
    display: none;
    height: auto;
    max-height: 8;
    margin: 0 1;
    border: none;
    background: $surface;
}
DataTable:focus,
DataTable:focus > .datatable--header,
RichLog:focus,
OptionList:focus,
Tree:focus,
Select:focus > SelectCurrent,
Select > SelectOverlay:focus,
Switch:focus {
    background-tint: transparent;
}
DataTable > .datatable--fixed {
    background: $background;
}
DataTable > .datatable--cursor,
DataTable:focus > .datatable--cursor,
DataTable > .datatable--fixed-cursor,
DataTable:focus > .datatable--fixed-cursor {
    background: $table-selection-background;
    color: $table-selection-foreground;
}
DataTable > .datatable--header-hover {
    background: $primary-muted;
}
SelectOverlay {
    border: tall $foreground-muted;
}
.compact_select { height: 1; }
.compact_select > SelectCurrent { border: none; height: 1; padding: 0 1; }
OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $button-color-foreground;
}
#history_bar_container {
    display: none;
    height: auto;
    background: $background;
}
#history_cmd_output {
    height: 4;
    margin: 0 1;
    background: $background;
}
#history_cmd_suggestions {
    display: none;
    height: auto;
    max-height: 8;
    margin: 0 1;
    border: none;
    background: $surface;
}
#history_input_wrapper {
    height: 4;
    padding: 0 1 0 1;
}
#history_input_bar {
    height: 3;
    border: round $warning;
    padding: 0 1;
    align: left middle;
    background: $background;
}
#history_prompt_char {
    width: auto;
    height: 100%;
    content-align: left middle;
    margin-right: 1;
    color: $warning;
}
#settings_pane {
    padding: 1 2;
    color: $foreground;
}
MCPPane { padding: 1 2; }
MCPPane .mcp_title { text-style: bold; height: 1; margin-bottom: 1; }
MCPPane .mcp_controls { height: 3; margin-bottom: 1; align: left middle; }
MCPPane .mcp_field_label { width: 8; height: 3; content-align: left middle; }
#mcp_status_row { height: auto; margin-bottom: 1; }
#mcp_status_row .mcp_field_label { height: 1; }
#mcp_state { width: 1fr; height: auto; padding-left: 2; }
#mcp_port { width: 10; margin-right: 2; background: transparent; }
#mcp_start, #mcp_stop { width: auto; min-width: 10; padding: 0 1; margin-right: 1; }
#mcp_control_group { width: auto; }
#mcp_help, #mcp_empty, #mcp_activity {
    height: auto; max-width: 90; color: $foreground-muted;
}
#mcp_activity { display: none; margin-top: 1; }
MCPPane .section_separator { margin: 0 0 1 0; }
#mcp_config {
    display: none; width: 1fr; max-width: 100; height: 9;
    border: none; padding: 0; background: $background;
}
#mcp_config:focus { border: none; }
#settings_title {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
}
#settings_pane Rule {
    margin: 0 0 1 0;
}
.settings_row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}
.settings_row Label {
    width: 30;
    content-align: left middle;
}
Switch {
    border: none;
    background: transparent;
}
Switch:focus {
    background-tint: $surface 0%;
}
Switch > .switch--slider {
    color: $error;
    background: $primary-muted;
}
Switch.-on > .switch--slider {
    color: $success;
}
#settings_depth_input {
    width: 10;
    height: 1;
    border: none;
    background: $panel;
}
#settings_depth_error {
    display: none;
    height: 1;
    color: $error;
    margin-left: 30;
}
#settings_theme { width: 11; }
#settings_theme > SelectCurrent { padding-left: 2; }
#settings_save {
    width: auto;
    min-width: 0;
    height: 3;
    border: round $foreground-muted;
    padding: 0 2;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#settings_save:hover,
#settings_save:focus {
    border: round $success;
    background: transparent;
    color: $success;
    background-tint: $surface 0%;
}
#home_split {
    height: 1fr;
}
#home_sidebar {
    width: 1fr;
    height: 1fr;
}
#home_separator { margin: 0; }
#home_logo {
    width: 1fr;
    height: auto;
    text-align: center;
}
#home_info {
    width: 1fr;
    height: auto;
    margin-top: 2;
    padding: 0 2;
}
#home_form {
    width: 2fr;
    padding: 1 2;
}
#home_title {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
}
#home_form Rule {
    margin: 1 0;
}
.connect_row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}
.connect_label {
    width: 12;
    height: 3;
    content-align: left middle;
    margin-right: 1;
}
.wide_connect_label {
    width: 18;
}
#home_device {
    width: 1fr;
}
#home_hooks_path, #home_script_path {
    width: 1fr;
    height: 3;
    border: tall $foreground-muted;
    background: $surface;
    padding: 0 1;
}
#home_hooks_browse, #home_script_browse,
#home_hooks_clear, #home_script_clear {
    width: auto;
    height: 3;
    border: round $foreground-muted;
    padding: 0 1;
    margin-left: 1;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#home_hooks_browse:hover, #home_hooks_browse:focus,
#home_script_browse:hover, #home_script_browse:focus {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#home_hooks_clear:hover, #home_hooks_clear:focus,
#home_script_clear:hover, #home_script_clear:focus {
    border: round $error-darken-1;
    color: $error;
    background: transparent;
}
#home_refresh, #home_target_refresh {
    width: auto;
    height: 3;
    border: round $foreground-muted;
    padding: 0 1;
    margin-left: 1;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#home_refresh:hover, #home_target_refresh:hover,
#home_refresh:focus, #home_target_refresh:focus {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#home_anr_row {
    height: 3;
}
#home_anr_bypass_label {
    width: auto;
    height: 1;
    content-align: left middle;
    margin-right: 2;
}
#home_system_anr_bypass {
    margin-right: 2;
}
#home_mode {
    width: 1fr;
}
#home_target_select {
    width: 1fr;
}
#home_form Select > SelectCurrent {
    border: tall $foreground-muted;
    background: $surface;
}
#home_form Select:focus > SelectCurrent {
    border: tall $foreground-muted;
}
SenderPane Select > SelectCurrent {
    border: round $foreground-muted;
    background: $background;
}

#info_prepare_sender {
    width: auto;
    min-width: 9;
}
#home_btn {
    width: 17;  /* "Connect" and "Connecting…" both centre evenly. */
    min-width: 0;
    height: 3;
    border: round $foreground-muted;
    padding: 0 2;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#home_btn:hover,
#home_btn:focus {
    border: round $success;
    background: transparent;
    color: $success;
    background-tint: $surface 0%;
}
#home_btn_row {
    height: auto;
    margin: 0;
}
#home_disconnect {
    width: auto;
    height: 3;
    border: round $foreground-muted;
    padding: 0 2;
    background: transparent;
    color: $foreground;
    text-style: bold;
    margin-left: 1;
}
#home_disconnect:hover,
#home_disconnect:focus {
    border: round $error-darken-1;
    background: transparent;
    color: $error;
    background-tint: $surface 0%;
}
#home_error {
    height: 1;
    color: $error;
    margin-top: 1;
}
#edit_form {
    display: none;
    height: 1fr;
    margin: 1 1;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}
.ef_row { height: 1; align: left middle; margin-bottom: 1; }
.ef_label { width: 16; content-align: left middle; color: $foreground-muted; }
.ef_row Input { padding: 0; }
#ef_grant_row { height: auto; margin-bottom: 1; }
#ef_grant_flags { height: auto; width: 1fr; }
#ef_readonly_context { height: auto; display: none; }
.ef_tree_line { height: auto; }
.ef_tree_field { height: 1; }
.ef_tree_label { width: auto; height: 1; }
.ef_tree_field Input { width: 1fr; height: 1; padding: 0; }
.ef_readonly_section { height: auto; }
.ef_context_body { height: auto; }
#ef_component_body, #ef_call_body { margin-bottom: 1; }
.ef_section_header { height: 1; align: left middle; margin-bottom: 1; }
.ef_add_header { height: 3; }
.ef_add_header .ef_section { height: 3; content-align: left middle; }
#ef_categories_header, #ef_extras_header { margin-bottom: 0; }
.ef_section { width: auto; text-style: bold; color: $foreground; }
.ef_section_meta { width: auto; margin-left: 2; color: $foreground-muted; }
.ef_section_spacer { width: 1fr; }
.ef_x_row { height: auto; min-height: 1; align: left top; }
.ef_x_row Input { height: 1; }
.ef_x_row ExtraValueInput { padding: 0 1; }
.ef_extra_block, .ef_extra_tree { height: auto; }
.ef_extra_tree { padding: 0 2; }
.ef_value_cell, .ef_value_summary { width: 1fr; height: auto; }
.ef_value_summary { padding: 0 1; }
.ef_value_note { height: auto; padding-left: 1; color: $foreground-muted; }
.ef_x_key_cell, .ef_x_key_input, .ef_x_key_header {
    width: 30%; min-width: 18; max-width: 40;
}
.ef_x_key_cell { height: auto; }
.ef_x_key_label {
    width: 1fr; height: auto; min-height: 1; padding-right: 1;
    text-wrap: wrap; text-overflow: fold;
}
.ef_x_key_label:focus { background: $boost; }
.ef_x_key_label > .extra-key--ellipsis { color: $foreground-muted; }
.ef_x_key_view {
    width: auto; min-width: 0; height: 1; margin-top: 1;
    padding: 0 1; border: none; background: $panel; color: $foreground-muted;
    text-style: bold; tint: transparent; background-tint: $surface 0%;
}
.ef_x_key_view:hover, .ef_x_key_view:focus, .ef_x_key_view.-active {
    color: $accent; background: $boost;
}
.ef_x_type_label, .ef_x_type_header, .ef_x_type_select { width: 16; }
.ef_x_type_label { color: $foreground-muted; }
.ef_x_columns { height: 1; color: $foreground-muted; text-style: bold; }
.ef_x_value_header { width: 1fr; padding-left: 1; }
.ef_x_remove_header { width: 5; margin-right: 2; }
.ef_x_key_input { padding: 0; }
.ef_x_type_select { height: 1; }
.ef_x_type_select > SelectCurrent { border: none; height: 1; padding: 0 1 0 0; }
.ef_x_type_select > SelectOverlay { width: 21; }
.ef_x_rm {
    width: 5;
    height: 1;
    border: none;
    min-width: 5;
    padding: 0;
    margin-right: 2;
    color: $foreground;
    text-style: bold;
    background: transparent;
    tint: transparent;
    background-tint: $surface 0%;
}
.ef_x_rm:hover, .ef_x_rm:focus, .ef_x_rm.-active {
    color: $error;
    text-style: bold;
    background: transparent;
    background-tint: $surface 0%;
}
#ef_extras {
    height: auto;
    layout: grid;
    grid-size: 1;
    grid-rows: auto;
    grid-gutter: 1 0;
}
#ef_categories { height: auto; }
#ef_categories.has-rows, #ef_extras.has-rows { padding: 0 0 1 0; }
#ef_add_extra, #ef_add_cat {
    width: auto;
    min-width: 0;
    height: 3;
    border: round $foreground-muted;
    padding: 0 1;
    color: $foreground;
    text-style: bold;
    background: transparent;
    tint: transparent;
    background-tint: $surface 0%;
}
#ef_add_extra:hover, #ef_add_extra:focus,
#ef_add_extra.-active,
#ef_add_cat:hover, #ef_add_cat:focus, #ef_add_cat.-active {
    color: $success;
    text-style: bold;
    border: round $success;
    background: transparent;
    background-tint: $surface 0%;
}
.ef_cat_row { height: 1; align: left middle; margin-top: 1; }
.ef_cat_input { height: 1; padding: 0; }
#edit_form Rule { margin: 1 0; }
#edit_form Rule.ef_add_separator { margin-bottom: 0; }
#ef_readonly_context Rule { margin: 0 0 1 0; }
#ef_selector_body, #ef_clip_body { padding-bottom: 1; }
#app_footer {
    dock: bottom;
    height: 1;
    background: $background;
}
Footer {
    dock: none;
    height: 1;
    width: 1fr;
    background: transparent;
}
#filter_count_label, #monitor_recording_status {
    width: auto;
    height: 1;
    color: $foreground-muted;
    content-align: right middle;
    padding: 0 2;
}
#monitor_recording_status { display: none; }

/* Info app tab */
#info_views.empty { height: 2; }
#info_views.empty > ContentSwitcher { display: none; }
#info_empty { padding: 1 2; color: $foreground-muted; }
.info_controls {
    height: 3;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
.info_controls Input {
    width: 1fr;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    background: transparent;
    border: round $foreground-muted;
}
.info_controls Input:focus {
    border: round $foreground-muted;
    background-tint: $surface 0%;
}
.info_controls Select {
    height: 3;
    margin-right: 1;
}
/* width = longest option + a couple of extra chars (Select chrome ~8 cells) */
#info_comp_type { width: 19; }
#info_perm_source { width: 21; }
.info_controls Select > SelectCurrent {
    border: round $foreground-muted;
    background: transparent;
}
.info_controls Select:focus > SelectCurrent {
    border: round $accent;
    background-tint: $surface 0%;
}
.switch-control {
    width: auto;
    height: 3;
    padding: 0 1;
    color: $foreground;
    border: round $foreground-muted;
    align: left middle;
}
.switch-control:focus-within { border: round $accent; }
.switch-control Switch {
    border: none;
    height: 1;
    padding: 0 1;
    margin: 0;
    background: transparent;
}
.switch-control-label {
    width: auto;
    height: 1;
    color: $foreground;
    content-align: left middle;
    margin-left: 1;
}
#info_perm_table, #info_comp_table { height: 1fr; margin: 1 1; }
#info_comp_detail { height: 12; margin: 1 1; background: $surface; }
#info_overview_log { height: 1fr; padding: 1 2; }

/* Sender request tabs and panes. */
SenderPane Button:disabled { width: auto; }
SenderPane #sender_tabs .request_tab.-selected { border: round $accent; color: $accent; }
SenderTabMenu OptionList > .option-list--option-highlighted { background: $accent 30%; color: $foreground; text-style: bold; }
SenderPane #sender_new, SenderPane #sender_new:hover, SenderPane #sender_new:focus, SenderPane #sender_new.-active { border: none; }
SenderPane #sender_new:hover, SenderPane #sender_new:focus { color: $accent; }

/* Sender JSON editor: flat, like the read-only panes beside it. */
SenderPane JsonArea, SenderPane JsonArea:focus { border: none; padding: 0; background: $background; }
