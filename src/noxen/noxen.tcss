Screen {
    background: $background;
    color: $foreground;
}
Screen, RichLog, DataTable, VerticalScroll, ScrollableContainer {
    scrollbar-background: $surface;
    scrollbar-color: $foreground-muted;
    scrollbar-color-hover: $success;
    scrollbar-color-active: $success;
}
#intercept_header {
    height: 3;
    background: $panel;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
#intercept_header Button {
    width: auto;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}
#intercept_header Button:focus {
    border: none;
    text-style: bold;
    background-tint: $surface 0%;
}
#intercept_header #intercept_toggle,
#intercept_header #btn_forward,
#intercept_header #btn_drop,
#intercept_header #btn_edit,
#intercept_header #btn_cancel_edit {
    height: 3;
    margin: 0 1 0 0;
    border: round $foreground-muted;
    background: $panel;
    color: $foreground-muted;
    text-style: bold;
}
#intercept_header #intercept_toggle:focus,
#intercept_header #btn_forward:focus,
#intercept_header #btn_drop:focus,
#intercept_header #btn_edit:focus,
#intercept_header #btn_cancel_edit:focus,
#intercept_header #intercept_toggle:hover,
#intercept_header #btn_forward:hover,
#intercept_header #btn_drop:hover,
#intercept_header #btn_edit:hover,
#intercept_header #btn_cancel_edit:hover {
    border: round $foreground-muted;
    background: $boost;
    background-tint: $surface 0%;
}
#intercept_header #intercept_toggle.intercept-on,
#intercept_header #intercept_toggle.intercept-on:focus,
#intercept_header #intercept_toggle.intercept-on:hover {
    border: round $success;
    background: $boost;
    color: $success;
}
#intercept_header #intercept_toggle.intercept-off,
#intercept_header #intercept_toggle.intercept-off:focus,
#intercept_header #intercept_toggle.intercept-off:hover {
    border: round $warning;
    background: $boost;
    color: $warning;
}
#intercept_header #btn_forward.forward-ready,
#intercept_header #btn_forward.forward-ready:focus,
#intercept_header #btn_forward.forward-ready:hover {
    border: round $secondary-darken-1;
    background: $boost;
    color: $secondary;
}
#intercept_header #btn_forward.apply-forward {
    width: 21;
    min-width: 21;
}
#intercept_header #btn_drop.drop-ready,
#intercept_header #btn_drop.drop-ready:focus,
#intercept_header #btn_drop.drop-ready:hover {
    border: round $error-darken-1;
    background: $boost;
    color: $error;
}
#intercept_header #btn_edit.edit-ready,
#intercept_header #btn_edit.edit-ready:focus,
#intercept_header #btn_edit.edit-ready:hover {
    border: round $secondary;
    background: $boost;
    color: $secondary-lighten-2;
}
#intercept_header #btn_cancel_edit {
    display: none;
    border: round $foreground-muted;
    background: $panel;
    color: $foreground;
}
#intercept_header #btn_cancel_edit:focus,
#intercept_header #btn_cancel_edit:hover {
    border: round $accent;
    background: $boost;
    color: $accent;
}
#intercept_header #btn_forward:disabled,
#intercept_header #btn_drop:disabled,
#intercept_header #btn_edit:disabled {
    border: round $foreground-muted;
    background: $panel;
    color: $foreground-muted;
}
#intercept_header #btn_intercept_filters,
#intercept_header #btn_intercept_stack {
    height: 3;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground;
}
#intercept_header #btn_intercept_filters:focus,
#intercept_header #btn_intercept_stack:focus,
#intercept_header #btn_intercept_filters:hover,
#intercept_header #btn_intercept_stack:hover {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#session_bar {
    height: 1;
    background: $panel;
    padding: 0 1;
    align: right middle;
}
#session_bar.connecting {
    background: $secondary;
}
#session_bar.connected {
    background: $success;
}
#session_bar.connection-error {
    background: $error;
}
#session_info {
    color: $foreground-muted;
    height: 1;
}
#session_bar.connecting #session_info,
#session_bar.connected #session_info,
#session_bar.connection-error #session_info {
    color: $button-color-foreground;
}
#intercept_header #intercept_toggle {
    width: 21;
}
#intercept_header_spacer { width: 1fr; }
TabbedContent {
    height: 1fr;
}
Tabs .underline--bar {
    color: $success;
}
Tab { text-style: bold; }
Tab.-active { background: $panel; color: $foreground; }
Tab.-active:focus { background: $panel; color: $foreground; }
Tab.intercepted { color: $error; }
TabPane {
    padding: 0;
    layout: vertical;
    background: $content-background;
}
#intercept_output {
    background: $surface;
    height: 1fr;
    margin: 1 1 0 1;
}
#log_header {
    height: 3;
    background: $panel;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
#log_output {
    background: $surface;
    height: 1fr;
    margin: 1 1 0 1;
}
#history_table {
    height: 1fr;
    margin: 1 1 0 1;
    border: solid $foreground-muted;
}
#history_detail {
    height: 1fr;
    margin: 0 1 0 1;
    background: $surface;
    border: solid $foreground-muted;
}
#history_header {
    height: 3;
    background: $panel;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
#history_header Button {
    width: auto;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}
#history_header Button:focus {
    border: none;
    text-style: bold;
    background-tint: $surface 0%;
}
#filter_bar_spacer { width: 0; }
#history_search {
    width: 1fr;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    background: $panel;
    border: round $foreground-muted;
}
#history_header #btn_history_filters,
#history_header #btn_history_stack {
    height: 3;
    border: round $foreground-muted;
    background: transparent;
    color: $foreground;
}
#history_header #btn_history_filters:focus,
#history_header #btn_history_stack:focus,
#history_header #btn_history_filters:hover,
#history_header #btn_history_stack:hover {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#history_header #btn_columns {
    margin: 0;
    padding: 0 1;
    width: auto;
    min-width: 0;
    height: 3;
    border: round $foreground-muted;
    background: $panel;
    color: $foreground;
    text-style: bold;
}
#history_header #btn_columns:hover,
#history_header #btn_columns:focus {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#intercept_cmd_output {
    height: 7;
    margin: 0 1;
    background: $surface;
    border-top: solid $panel;
}
#intercept_input_wrapper {
    height: 4;
    padding: 0 1 0 1;
}
#intercept_input_bar {
    height: 3;
    border: round $warning;
    padding: 0 1;
    align: left middle;
    background: $surface;
}
#intercept_prompt_char {
    width: auto;
    height: 100%;
    content-align: left middle;
    margin-right: 1;
    color: $warning;
}
Input {
    border: none;
    width: 1fr;
}
Input:focus {
    border: none;
    background-tint: $surface 0%;
}
#intercept_input_bar.intercepted {
    border: round $error;
}
#intercept_input_bar.intercepted #intercept_prompt_char {
    color: $error;
}
#intercept_cmd_suggestions {
    display: none;
    height: auto;
    max-height: 8;
    margin: 0 1;
    border: none;
    background: $surface;
}
DataTable > .datatable--cursor {
    background: $primary;
    color: $button-color-foreground;
}
DataTable > .datatable--header-hover {
    background: $primary-muted;
}
SelectOverlay {
    border: tall $foreground-muted;
}
OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $button-color-foreground;
}
#history_bar_container {
    display: none;
    height: auto;
}
#history_cmd_output {
    height: 4;
    margin: 0 1;
    background: $surface;
    border-top: solid $panel;
}
#history_cmd_suggestions {
    display: none;
    height: auto;
    max-height: 8;
    margin: 0 1;
    border: none;
    background: $surface;
}
#history_input_wrapper {
    height: 4;
    padding: 0 1 0 1;
}
#history_input_bar {
    height: 3;
    border: round $warning;
    padding: 0 1;
    align: left middle;
    background: $surface;
}
#history_prompt_char {
    width: auto;
    height: 100%;
    content-align: left middle;
    margin-right: 1;
    color: $warning;
}
#settings_pane {
    padding: 1 2;
    color: $foreground;
}
#settings_title {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
}
#settings_pane Rule {
    color: $foreground-muted;
    margin: 0 0 1 0;
}
.settings_row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}
.settings_row Label {
    width: 30;
    content-align: left middle;
}
.settings_switch_row Label {
    width: 28;
}
Switch {
    border: none;
    background: transparent;
}
Switch:focus {
    background-tint: $surface 0%;
}
Switch > .switch--slider {
    color: $error;
    background: $primary-muted;
}
Switch.-on > .switch--slider {
    color: $success;
}
#settings_depth_input {
    width: 10;
    height: 1;
    border: none;
    background: $panel;
}
#settings_depth_error {
    height: 1;
    color: $error;
    margin-left: 30;
}
#settings_save {
    width: auto;
    min-width: 0;
    height: 3;
    border: round $foreground-muted;
    padding: 0 2;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#settings_save:hover,
#settings_save:focus {
    border: round $success;
    background: transparent;
    color: $success;
    background-tint: $surface 0%;
}
#home_split {
    height: 1fr;
}
#home_sidebar {
    width: 1fr;
    height: 1fr;
    border-right: solid $foreground-muted;
}
#home_logo {
    width: 1fr;
    height: auto;
    text-align: center;
}
#home_info {
    width: 1fr;
    height: auto;
    margin-top: 2;
    padding: 0 2;
}
#home_form {
    width: 2fr;
    padding: 1 2;
}
#home_title {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
}
#home_form Rule {
    color: $foreground-muted;
    margin: 1 0;
}
.connect_row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}
.connect_label {
    width: 12;
    height: 3;
    content-align: left middle;
    margin-right: 1;
}
.wide_connect_label {
    width: 18;
}
#home_device {
    width: 1fr;
}
#home_hooks_path, #home_script_path {
    width: 1fr;
    height: 3;
    border: tall $foreground-muted;
    background: $surface;
    padding: 0 1;
}
#home_hooks_browse, #home_script_browse,
#home_hooks_clear, #home_script_clear {
    width: auto;
    height: 3;
    border: round $foreground-muted;
    padding: 0 1;
    margin-left: 1;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#home_hooks_browse:hover, #home_hooks_browse:focus,
#home_script_browse:hover, #home_script_browse:focus {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#home_hooks_clear:hover, #home_hooks_clear:focus,
#home_script_clear:hover, #home_script_clear:focus {
    border: round $error-darken-1;
    color: $error;
    background: transparent;
}
#home_refresh, #home_target_refresh {
    width: auto;
    height: 3;
    border: round $foreground-muted;
    padding: 0 1;
    margin-left: 1;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#home_refresh:hover, #home_target_refresh:hover,
#home_refresh:focus, #home_target_refresh:focus {
    border: round $accent;
    background: transparent;
    color: $accent;
}
#home_anr_row {
    height: 3;
}
#home_anr_bypass_label {
    width: auto;
    height: 1;
    content-align: left middle;
    margin-right: 2;
}
#home_system_anr_bypass {
    margin-right: 2;
}
#home_mode {
    width: 1fr;
}
#home_target_select {
    width: 1fr;
}
#home_form Select > SelectCurrent {
    border: tall $foreground-muted;
    background: $surface;
}
#home_form Select:focus > SelectCurrent {
    border: tall $foreground-muted;
}
#home_btn {
    width: auto;
    min-width: 18;
    height: 3;
    border: round $foreground-muted;
    padding: 0 2;
    background: transparent;
    color: $foreground;
    text-style: bold;
}
#home_btn:hover,
#home_btn:focus {
    border: round $success;
    background: transparent;
    color: $success;
    background-tint: $surface 0%;
}
#home_btn_row {
    height: auto;
    margin: 0;
}
#home_disconnect {
    width: auto;
    height: 3;
    border: round $foreground-muted;
    padding: 0 2;
    background: transparent;
    color: $foreground;
    text-style: bold;
    margin-left: 1;
}
#home_disconnect:hover,
#home_disconnect:focus {
    border: round $error-darken-1;
    background: transparent;
    color: $error;
    background-tint: $surface 0%;
}
#home_error {
    height: 1;
    color: $error;
    margin-top: 1;
}
#edit_form {
    display: none;
    height: 1fr;
    margin: 1 1 0 1;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}
#ef_mode_label {
    height: 1;
    margin-bottom: 1;
    color: $secondary;
    text-style: bold;
}
.ef_row { height: 1; align: left middle; margin-bottom: 1; }
.ef_label { width: 12; content-align: left middle; }
.ef_section_header { height: 3; align: left middle; }
.ef_section { width: auto; text-style: bold; color: $warning; }
.ef_section_spacer { width: 1fr; }
.ef_x_row { height: 1; align: left middle; margin-bottom: 1; }
.ef_x_key_label { width: 18; }
.ef_x_type_label { width: 25; color: $foreground-muted; }
.ef_x_columns { height: 1; color: $foreground-muted; text-style: bold; }
.ef_x_key_header { width: 18; }
.ef_x_type_header { width: 25; }
.ef_x_value_header { width: 1fr; padding-left: 2; }
.ef_x_remove_header { width: 3; }
.ef_x_key_input { width: 18; padding: 0; }
.ef_x_type_select { width: 25; height: 1; }
.ef_x_type_select > SelectCurrent { border: none; height: 1; padding: 0 1; }
.ef_x_rm {
    width: 3;
    height: 1;
    border: none;
    min-width: 3;
    padding: 0;
    color: $foreground-muted;
    background: transparent;
}
.ef_x_rm:hover, .ef_x_rm:focus {
    color: $error;
    background: $boost;
    background-tint: $surface 0%;
}
#ef_extras { height: auto; }
#ef_categories { height: auto; }
#ef_add_extra, #ef_add_cat {
    width: auto;
    height: 1;
    border: none;
    padding: 0 1;
    color: $foreground;
    background: transparent;
}
#ef_add_extra:hover, #ef_add_extra:focus,
#ef_add_cat:hover, #ef_add_cat:focus {
    color: $success;
    background: $boost;
    background-tint: $surface 0%;
}
.ef_cat_row { height: 1; align: left middle; margin-bottom: 1; }
.ef_cat_input { padding: 0; }
#edit_form Rule { margin: 0 2 0 0; color: $foreground-muted; }
#app_footer {
    dock: bottom;
    height: 1;
}
Footer {
    dock: none;
    height: 1;
    width: 1fr;
}
#filter_count_label {
    width: auto;
    height: 1;
    background: $panel;
    color: $foreground-muted;
    content-align: right middle;
    padding: 0 2;
}

/* Info app tab */
#info_split { height: 1fr; }
#info_rail {
    width: 22;
    height: 1fr;
    border-right: solid $foreground-muted;
    padding: 1 0;
}
.info-nav {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    text-style: none;
}
/* keep the rail flat: no hover/press/focus background, border or reverse */
.info-nav:hover,
.info-nav:focus,
.info-nav.-active {
    background: transparent;
    border: none;
    tint: transparent;
    background-tint: $surface 0%;
    text-style: none;
}
.info-nav:hover,
.info-nav:focus {
    color: $accent;
}
.info-nav.active,
.info-nav.active:hover,
.info-nav.active:focus,
.info-nav.active.-active {
    background: $boost;
    border: none;
    tint: transparent;
    background-tint: $surface 0%;
    color: $foreground;
    text-style: bold;
}
#info_main { width: 1fr; height: 1fr; color: $foreground; }
#info_empty { padding: 1 2; color: $foreground-muted; }
#info_switcher { height: 1fr; }
.info_controls {
    height: 3;
    background: $panel;
    color: $foreground;
    padding: 0 1;
    align: left middle;
}
.info_controls Input {
    width: 1fr;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    background: $panel;
    border: round $foreground-muted;
}
.info_controls Input:focus {
    border: round $foreground-muted;
    background-tint: $surface 0%;
}
.info_controls Select {
    height: 3;
    margin-right: 1;
}
/* width = longest option + a couple of extra chars (Select chrome ~8 cells) */
#info_comp_type { width: 19; }
#info_perm_source { width: 21; }
.info_controls Select > SelectCurrent {
    border: round $foreground-muted;
    background: $panel;
}
.info_controls Select:focus > SelectCurrent {
    border: round $accent;
    background-tint: $surface 0%;
}
.switch-control {
    width: auto;
    height: 3;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    border: round $foreground-muted;
    align: left middle;
}
.switch-control:focus-within { border: round $accent; }
.switch-control Switch {
    border: none;
    height: 1;
    padding: 0 1;
    margin: 0;
    background: $panel;
}
.switch-control-label {
    width: auto;
    height: 1;
    color: $foreground;
    content-align: left middle;
    margin-left: 1;
}
#info_perm_table, #info_comp_table { height: 1fr; margin: 1 1 0 1; border: solid $foreground-muted; }
#info_comp_detail { height: 12; margin: 0 1 1 1; border: solid $foreground-muted; background: $surface; }
#info_overview_log { height: 1fr; padding: 1 2; }
